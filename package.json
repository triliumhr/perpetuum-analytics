{
    "name": "perpetuum-analytics-workspace",
    "private": true,
    "description": "Workspace for the perpetuum-analytics package (projects/perpetuum-analytics).",
    "license": "MIT",
    "engines": {
        "node": "^22.22.3 || >=24.15.0"
    },
    "scripts": {
        "ng": "ng",
        "build": "ng build perpetuum-analytics && node tools/copy-package-files.mjs",
        "test": "ng test perpetuum-analytics --watch=false",
        "lint": "ng lint perpetuum-analytics",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "pack:check": "npm run build && cd dist/perpetuum-analytics && npm pack --dry-run && publint"
    },
    "devDependencies": {
        "@angular-eslint/builder": "^22.6.0",
        "@angular/build": "^22.2.4",
        "@angular/cli": "^22.2.4",
        "@angular/common": "^22.2.3",
        "@angular/compiler": "^22.2.3",
        "@angular/compiler-cli": "^22.2.3",
        "@angular/core": "^22.2.3",
        "@angular/platform-browser": "^22.2.3",
        "@angular/router": "^22.2.3",
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^5.0.5",
        "angular-eslint": "^22.6.0",
        "eslint": "^10.13.0",
        "jsdom": "^30.1.3",
        "ng-packagr": "^22.2.5",
        "prettier": "^3.9.10",
        "publint": "^0.3.25",
        "rxjs": "~7.8.0",
        "tslib": "^2.8.1",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    }
}
