{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "packageManager": "npm",
        "analytics": false
    },
    "newProjectRoot": "projects",
    "projects": {
        "perpetuum-analytics": {
            "projectType": "library",
            "root": "projects/perpetuum-analytics",
            "sourceRoot": "projects/perpetuum-analytics/src",
            "prefix": "perpetuum",
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/perpetuum-analytics/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/perpetuum-analytics/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "projects/perpetuum-analytics/tsconfig.spec.json",
                        "coverageInclude": ["projects/perpetuum-analytics/src/lib/**/*.ts"],
                        "coverageExclude": ["**/*.spec.ts", "**/testing/**"],
                        "coverageThresholds": {
                            "statements": 100,
                            "branches": 100,
                            "functions": 100,
                            "lines": 100
                        }
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": ["projects/perpetuum-analytics/**/*.ts", "projects/perpetuum-analytics/**/*.html"]
                    }
                }
            }
        }
    }
}
